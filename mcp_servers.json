{
  "mcpServers": {
    
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/lecorn/Projects/ai-qa-project/data/output"],
      "env": {},
      "cwd": null
    },

    "knowledge": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "ai_qa.infrastructure.mcp.server"],
      "env": {
        "PYTHONPATH": "./src"
      },
      "cwd": "."
    },

    "g-search": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "g-search-mcp"],
      "env": {},
      "cwd": null
    },

    "elasticsearch": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "ES_URL",
        "-e", "ES_API_KEY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "http://localhost:9200",
        "ES_API_KEY": "your-api-key"
      },
      "cwd": null
    },

    "grafana": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana",
        "-t", "stdio"
      ],
      "env": {
        "GRAFANA_URL": "http://host.docker.internal:4000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "your-token-here"
      },
      "cwd": null
    },

    "amap": {
      "transport": "sse",
      "url": "https://mcp.amap.com/sse?key=801aabf79ed055c2ff78603cfe851787",
      "headers": {},
      "timeout": 30.0
    },

    "baidu-search": {
      "transport": "sse",
      "url": "https://appbuilder.baidu.com/v2/ai_search/mcp/sse?api_key=bce-v3/ALTAK-8UcznyJuL4Y2XL6wE9khp/81262741c8a367fadc9a455c8fe4e1e83947525a",
      "headers": {},
      "timeout": 30.0
    },

    "how-to-cook": {
      "transport": "sse",
      "url": "http://127.0.0.1:8103/sse",
      "headers": {},
      "timeout": 30.0
    },
    "CSDN自动发帖": {
      "transport": "sse",
      "url": "http://127.0.0.1:8101/sse",
      "headers": {},
      "timeout": 180.0
    },
    "微信公众号消息通知": {
